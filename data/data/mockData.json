  "firstAidGuides": [
    {
      "id": "cpr",
      "title": "CPR (Cardiopulmonary Resuscitation)",
      "category": "Critical",
      "icon": "❤️",
      "steps": [
        "Check responsiveness: Tap shoulders and shout 'Are you okay?'.",
        "Call for help: Dial 112 / 108 immediately and get an AED if available.",
        "Position hands: Place heel of one hand in center of chest, interlock other hand.",
        "Compressions: Push hard and fast (100–120 compressions per minute) at 2 inches depth.",
        "Rescue breaths: Give 2 rescue breaths after every 30 compressions if trained."
      ]
    },
    {
      "id": "bleeding",
      "title": "Severe Bleeding Control",
      "category": "Trauma",
      "icon": "🩸",
      "steps": [
        "Apply direct pressure: Use a clean cloth or gloved hands directly over wound.",
        "Elevate: Raise the injured limb above heart level if no fracture suspected.",
        "Secure bandage: Wrap tightly with sterile bandage without stopping circulation.",
        "Tourniquet (Last resort): Apply 2–3 inches above severe limb wound if pressure fails.",
        "Keep patient warm and elevate legs to treat for shock."
      ]
    },
    {
      "id": "choking",
      "title": "Heimlich Maneuver (Choking)",
      "category": "Airway",
      "icon": "🫁",
      "steps": [
        "Stand behind victim: Wrap arms around their waist.",
        "Make a fist: Place thumb side of fist slightly above navel.",
        "Thrusts: Perform quick, upward abdominal thrusts until object clears.",
        "For infants: Give 5 back blows followed by 5 chest thrusts."
      ]
    },
    {
      "id": "burns",
      "title": "Burn First Aid",
      "category": "Thermal",
      "icon": "🔥",
      "steps": [
        "Cool immediately: Run cool (not icy) water over burn for at least 10–20 minutes.",
        "Do NOT apply ice, butter, or toothpaste.",
        "Cover loosely: Use sterile non-stick bandage or clean wrap.",
        "Seek medical help if burn is larger than palm or on face/joints."
      ]
    },
    {
      "id": "seizures",
      "title": "Seizure Response",
      "category": "Neurological",
      "icon": "⚡",
      "steps": [
        "Ease to floor: Protect head with cushion or folded jacket.",
        "Turn on side: Helps keep airway clear.",
        "Do NOT insert anything into person's mouth or restrain movements.",
        "Time the seizure: Call emergency if seizure lasts longer than 5 minutes."
      ]
    }
  ]
